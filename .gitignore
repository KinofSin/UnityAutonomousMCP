# Node
node_modules/
server/node_modules/
package-lock.json
npm-debug.log*

# Build output
server/dist/
*.tsbuildinfo

# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/
MemoryCaptures/

# IDE
.vscode/
.windsurf/
.DS_Store
Thumbs.db
.env
.env.*
.superpowers/

# VRChat optimization loop state (machine-local measurements)
.claude/.vrc-state/

# Supervisor config — absolute paths to this machine's Unity install/project.
# Committed as unity-project.example.json instead.
.claude/unity-project.json

# .meta residue from the old repo-root Unity mount (mount the package SUBFOLDER instead).
# Each of these shadows a path that is already ignored above.
/node_modules.meta
/package.json.meta
/package-lock.json.meta
/server.meta
/server/**/*.meta

# Generator scratch output
tmp_*.png

# Agent scratch: bridge params, execute_csharp snippets, commit messages, screenshots.
# PowerShell mangles inline JSON, so these get written to disk constantly and a
# `git add -A` will otherwise sweep them into a commit.
tmp-*.json
tmp-*.txt
tmp-*.png
